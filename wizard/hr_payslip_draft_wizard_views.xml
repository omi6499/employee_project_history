<odoo>
    <record id="view_payslip_draft_wizard" model="ir.ui.view">
        <field name="name">hr.payslip.draft.wizard.form</field>
        <field name="model">hr.payslip.draft.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Draft Entry">
                <sheet>
                    <group>
                        <field name="payment_type"/>
                        <field name="note"/>
                    </group>
                    <footer>
                        <button name="confirm_payslip" type="object" string="Confirm" class="btn btn-primary"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- server action replace for wizard  -->
    <record id="hr_payroll.action_hr_payroll_confirm_payroll" model="ir.actions.server">
        <field name="name">Create Draft Entry</field>
        <field name="model_id" ref="employee_project_history.model_hr_payslip"/>
        <field name="binding_model_id" ref="employee_project_history.model_hr_payslip"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_payslip_draft_wizard()</field>
    </record>

    <!-- Payslip Batch sequence -->
    <record id="seq_hr_payslip_run" model="ir.sequence">
        <field name="name">Payslip Batch Sequence</field>
        <field name="code">hr.payslip.batch.seq</field>
        <field name="padding">2</field>
        <field name="use_date_range" eval="True"/>
    </record>

</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="hr_employee_form_view_inherit_id" model="ir.ui.view">
            <field name="name">hr.employee.form.inherite</field>
            <field name="model">hr.employee</field>
            <field name="priority" eval="8"/>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='mobile_phone']" position="before">
                    <field name="employee_number" string="Employee ID"/>
                    <field name="employee_category_id"/>
                </xpath>
                <xpath expr="//form/sheet/group/group[1]/field[@name='company_id']" position="after">
                    <label for="employee_project_id"/>
                    <div class="o_row">
                        <field name="employee_project_id" readonly="1"/>
                        <button name="action_open_project_update_wizard" type="object" class="btn"
                                string="Update Project"/>
                    </div>
                    <field name="employee_project_region_id" readonly="1"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page name="project_history" string="Project History">
                        <div class="row mt-2">
                            <div class="o_hr_skills_group o_group_resume col-lg-7 d-flex">
                                <field mode="tree" nolabel="1" name="employee_project_history_ids"
                                       widget="experience_one2many"
                                       readonly="not user_has_project_hist_edit" force_save="1">
                                    <tree>
                                        <field name="line_type_id"/>
                                        <field name="name"/>
                                        <field name="description"/>
                                        <field name="employee_project_region_id"/>
                                        <field name="designation_id"/>
                                        <field name="change_reason_id"/>
                                        <field name="date_start"/>
                                        <field name="date_end"/>
                                        <field name="display_type" column_invisible="True"/>
                                    </tree>
                                </field>
                            </div>
                            <div class="o_hr_skills_group o_group_resume col-lg-7 d-flex"/>
                        </div>
                    </page>
                    <page name="vacation_history" string="Vaction History">
                        <field name="vaction_history_ids">
                            <tree editable="bottom">
                                <field name="employee_id"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="total_days"/>
                            </tree>
                        </field>
                    </page>
                    <field name="user_has_project_hist_edit" invisible="1" />
                </xpath>
            </field>
        </record>

        <record id="hr_kanban_view_employees_inherit" model="ir.ui.view">
            <field name="name">hr.kanban.view.employees.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='category_ids']" position="after">
                        <field name="employee_project_id" display="full"/>
                        <field name="employee_project_region_id" display="full"/>
                    </xpath>
                    <xpath expr="//field[@name='job_title']" position="after">
                        <field name="employee_number" display="full"/>
                    </xpath>
                </data>
            </field>
        </record>

        <record model="ir.ui.view" id="view_employee_tree_inherit">
            <field name="name">hr.tree.view.employees.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree[1]/header[1]" position="after">
                    <field name="employee_number" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>